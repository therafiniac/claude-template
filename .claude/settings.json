{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rafi-tools": {
      "source": {
        "source": "github",
        "repo": "therafiniac/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "rafi@rafi-tools": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm lighthouse)",
      "Bash(pnpm build)",
      "Bash(pnpm audit)",
      "Bash(pnpm audit --prod)",
      "Bash(pnpm audit --prod *)",
      "Bash(pnpm outdated)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm why *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git switch *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git merge --no-ff *)",
      "Bash(git rebase dev)",
      "Bash(git rebase origin/dev)",
      "Bash(git tag -a *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push --follow-tags *)",
      "Bash(git branch -d *)",
      "Bash(git push origin --delete *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)"
    ]
  }
}
