{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rafi-tools": {
      "source": {
        "source": "github",
        "repo": "therafiniac/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "rafi@rafi-tools": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm lighthouse)",
      "Bash(pnpm build)",
      "Bash(pnpm audit)",
      "Bash(pnpm audit --prod)",
      "Bash(pnpm audit --prod *)",
      "Bash(pnpm outdated)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm why *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)"
    ]
  }
}
